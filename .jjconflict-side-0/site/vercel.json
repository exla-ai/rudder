{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rudder.viraat.dev"
        }
      ],
      "destination": "https://rudder.exla.ai/:path*",
      "permanent": true
    },
    {
      "source": "/login",
      "has": [{ "type": "query", "key": "device_code" }],
      "destination": "https://rudder-cloud-control.fly.dev/cli/login",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://rudder-cloud-control.fly.dev/app",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://rudder-cloud-control.fly.dev/app",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "https://github.com/exla-ai/rudder/releases/latest/download/Rudder.dmg",
      "permanent": false
    },
    {
      "source": "/setup",
      "destination": "/docs/setup",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://rudder-cloud-control.fly.dev/health"
    }
  ]
}
