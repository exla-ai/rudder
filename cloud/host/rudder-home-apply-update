#!/bin/sh
# Applies an image update the home asked for. The supervisor writes
# desired.json on the volume when the control plane sends it an `update` RPC
# (cloud/worker/home-host.mjs); rudder-home-update.path runs this as root:
# pull the image, put the new worker token in home.env, recreate the container.
#
# The token is never printed. A request that cannot be applied is set aside as
# desired.failed.json so the path unit does not retry it in a loop, with one
# line saying why in desired.failed.reason. The home reports that to the
# control plane, which drops the request's token so the next update can go.
# The control plane keeps accepting the old token throughout.
set -eu
umask 077

CONF=${RUDDER_HOST_CONF:-/etc/rudder}
DATA=${RUDDER_HOST_DATA:-/srv/workspace}
START=${RUDDER_HOME_START:-/usr/local/bin/rudder-home-start}
DIR="$DATA/.rudder-host"
DESIRED="$DIR/desired.json"
FAILED="$DIR/desired.failed.json"
REASON="$DIR/desired.failed.reason"

[ -f "$DESIRED" ] || exit 0

# The volume is writable from inside the container, so root never writes a
# file there: the reason is written as the directory's owner (the worker,
# uid 1500), and a link planted in its place reaches only what it could write.
as_volume_owner() {
  if [ "$(id -u)" = 0 ]; then
    owner=$(stat -c %u:%g "$DIR") || return 1
    setpriv --reuid="${owner%:*}" --regid="${owner#*:}" --clear-groups "$@"
  else
    "$@"
  fi
}

# One short line for the home's dashboards. Only plain characters survive.
note() {
  line=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._:/@()?,;=+-' | cut -c 1-300)
  as_volume_owner sh -c 'printf "%s\n" "$2" > "$1.tmp" && mv -f "$1.tmp" "$1"' sh "$REASON" "$line" 2>/dev/null || true
}

fail() {
  echo "rudder-home-apply-update: $1" >&2
  note "$1"
  mv -f "$DESIRED" "$FAILED" 2>/dev/null || rm -f "$DESIRED"
  exit 1
}

# systemd stops a run that takes longer than the unit's TimeoutStartSec.
trap 'fail "the update was stopped before it finished (a pull took too long?)"' TERM INT HUP

# One field of the single-line object home-host.mjs writes. Both values are
# checked against strict shapes before docker or the env file sees them.
field() {
  sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$DESIRED" | head -n 1
}

# An image reference without its tag or digest.
repository() {
  ref=${1%%@*}
  case ${ref##*/} in
    *:*) ref=${ref%:*} ;;
  esac
  printf '%s\n' "$ref"
}

IMAGE=$(field image)
TOKEN=$(field workerToken)
printf '%s\n' "$IMAGE" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._/:@-]{0,255}' || fail "the requested image is not a valid reference"
printf '%s\n' "$TOKEN" | grep -Eqx 'rdrw_[A-Za-z0-9_-]{16,200}' || fail "the requested worker token is malformed"

# The volume is writable from inside the container, so a request may only move
# to another tag or digest of the image this host already runs.
CURRENT=$(cat "$CONF/image" 2>/dev/null || true)
if [ -n "$CURRENT" ] && [ "$(repository "$IMAGE")" != "$(repository "$CURRENT")" ]; then
  fail "refusing $IMAGE: not the same repository as $CURRENT"
fi

case $IMAGE in
  */*) REGISTRY=${IMAGE%%/*} ;;
  *) REGISTRY=docker.io ;;
esac
case $REGISTRY in
  *.*|*:*|localhost) ;;
  *) REGISTRY=docker.io ;;
esac

echo "rudder-home-apply-update: pulling $IMAGE"
if ! PULL_ERROR=$(docker pull -q "$IMAGE" 2>&1 >/dev/null); then
  printf '%s\n' "$PULL_ERROR" >&2
  if printf '%s\n' "$PULL_ERROR" | grep -Eqi 'unauthorized|denied|forbidden|authentication required|no basic auth'; then
    fail "docker pull was refused by $REGISTRY; log this host in again (sudo docker login $REGISTRY)"
  fi
  fail "docker pull $IMAGE failed: $(printf '%s\n' "$PULL_ERROR" | grep . | tail -n 1)"
fi

# A newer request arrived during the pull: the path unit runs it next.
[ "$(field workerToken)" = "$TOKEN" ] || exit 0
trap - TERM INT HUP

# Every other line of the env file stays; only the token changes.
grep -v '^RUDDER_WORKER_TOKEN=' "$CONF/home.env" > "$CONF/home.env.tmp" || true
printf 'RUDDER_WORKER_TOKEN=%s\n' "$TOKEN" >> "$CONF/home.env.tmp"
chmod 600 "$CONF/home.env.tmp"
mv -f "$CONF/home.env.tmp" "$CONF/home.env"
printf '%s\n' "$IMAGE" > "$CONF/image.tmp"
mv -f "$CONF/image.tmp" "$CONF/image"
rm -f "$DESIRED" "$FAILED" "$REASON"

"$START"
