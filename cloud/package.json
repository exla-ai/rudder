{
  "name": "@exla/rudder-cloud",
  "version": "0.7.7",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build-editor",
    "build-editor": "esbuild editor/codemirror.js --bundle --minify --format=esm --legal-comments=none --outfile=app/vendor/codemirror.js && node editor/precompress.mjs app/vendor/codemirror.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/credential-provider-web-identity": "^3.972.85",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "better-auth": "^1.4.0",
    "better-sqlite3": "^12.5.0",
    "pg": "8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.5.13",
    "codemirror": "6.0.2",
    "esbuild": "0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
