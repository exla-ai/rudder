diff --git a/engine/src/execution/network/connected/validity.rs b/engine/src/execution/network/connected/validity.rs
new file mode 100644
index 0000000..ca78cd4
--- /dev/null
+++ b/engine/src/execution/network/connected/validity.rs
@@ -0,0 +1,163 @@
+//! Actual retained validation, separate from its non-authorizing time DATA.
+use super::{ConnectBinding, ConnectError as Error, ConnectErrorKind as Kind,
+    ConnectResult as Result, HostIpv4DenySet};
+use std::sync::{Arc, Mutex, atomic::{AtomicBool, Ordering}};
+
+const NS_PER_MS: u128 = 1_000_000;
+pub(crate) const ADOPTION_LIMIT_MS: i64 = 200;
+pub(crate) const MAX_STALENESS_MS: i64 = 500;
+
+#[derive(Clone, Copy)]
+struct Sample { wall_ms:i64, boot_ns:u128 }
+impl Sample {
+    fn now() -> Result<Self> {
+        let mut boot = libc::timespec { tv_sec:0, tv_nsec:0 };
+        let mut wall = libc::timespec { tv_sec:0, tv_nsec:0 };
+        if unsafe { libc::clock_gettime(libc::CLOCK_BOOTTIME, &mut boot) } != 0
+            || unsafe { libc::clock_gettime(libc::CLOCK_REALTIME, &mut wall) } != 0
+            || boot.tv_sec < 0 || wall.tv_sec < 0
+            || !(0..1_000_000_000).contains(&boot.tv_nsec)
+            || !(0..1_000_000_000).contains(&wall.tv_nsec) {
+            return Err(Error::new(Kind::AuthorityDenied));
+        }
+        Ok(Self { wall_ms:i64::try_from(wall.tv_sec).ok()
+                .and_then(|s|s.checked_mul(1000)).and_then(|s|s.checked_add(wall.tv_nsec as i64 / 1_000_000))
+                .ok_or_else(||Error::new(Kind::AuthorityDenied))?,
+            boot_ns:(boot.tv_sec as u128) * 1_000_000_000 + boot.tv_nsec as u128 })
+    }
+}
+
+/// Original absolute wall/BOOTTIME bounds, DATA only. The trusted adapter must
+/// copy the grant/inventory producer's original bounds, never now + a TTL.
+/// No Serde, wall-only conversion or engine constructor can grant authority.
+#[derive(Clone, Copy)]
+pub struct ConnectDeadline { wall_ms:i64, boot_ns:u128 }
+impl ConnectDeadline {
+    pub fn from_original(wall_ms:i64, boot_ns:u128) -> Result<Self> {
+        if wall_ms <= 0 || boot_ns == 0 { return Err(Error::new(Kind::InvalidConfiguration)); }
+        Ok(Self { wall_ms, boot_ns })
+    }
+    fn after(start: Sample, ms:i64) -> Result<Self> {
+        Self::from_original(start.wall_ms.checked_add(ms).ok_or_else(||Error::new(Kind::Deadline))?,
+            start.boot_ns.checked_add(ms as u128 * NS_PER_MS).ok_or_else(||Error::new(Kind::Deadline))?)
+    }
+    fn check(self, sample: Sample) -> Result<()> {
+        if sample.wall_ms >= self.wall_ms || sample.boot_ns >= self.boot_ns {
+            Err(Error::new(Kind::AuthorityDenied))
+        } else { Ok(()) }
+    }
+}
+
+/// Created only by Runtime BEFORE calling the trusted authority. The private
+/// identity prevents returning another query's validation for matching DATA.
+/// Adoption and continuing max-staleness are distinct original deadlines.
+pub struct ConnectQuery {
+    binding:ConnectBinding,
+    identity:Arc<()>,
+    started:Sample,
+    adopt_by:ConnectDeadline,
+    stale_at:ConnectDeadline,
+}
+impl ConnectQuery {
+    pub(crate) fn begin(binding: &ConnectBinding) -> Result<Self> {
+        let started = Sample::now()?;
+        Ok(Self { binding:binding.clone(), identity:Arc::new(()), started,
+            adopt_by:ConnectDeadline::after(started, ADOPTION_LIMIT_MS)?,
+            stale_at:ConnectDeadline::after(started, MAX_STALENESS_MS)? })
+    }
+    pub fn binding(&self) -> &ConnectBinding { &self.binding }
+    pub(crate) fn identity(&self) -> Arc<()> { self.identity.clone() }
+}
+
+/// Retains actual host authority/inventory custody. Implementations check their
+/// original owner/revision/clocks and never mint or renew a grant here. Calls
+/// can block: fixed caller workers remain owned until their ACTUAL joins.
+/// The independent watchdog uses only ConnectValidation's immutable bounds.
+pub trait ConnectValidationGuard: Send + Sync + 'static {
+    fn check_current(&self) -> Result<()>;
+}
+
+/// Neither Clone nor Serde. Runtime retains an Arc to this actual result, not
+/// its address list or a receiver-created expiry. Time errors are absorbing.
+pub struct ConnectValidation {
+    query:ConnectQuery,
+    grant:ConnectDeadline,
+    inventory:ConnectDeadline,
+    producer_current_until:ConnectDeadline,
+    addresses:HostIpv4DenySet,
+    owner:Arc<dyn ConnectValidationGuard>,
+    last:Mutex<Sample>,
+    denied:AtomicBool,
+}
+impl std::fmt::Debug for ConnectValidation {
+    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        out.write_str("ConnectValidation([retained custody])")
+    }
+}
+impl ConnectValidation {
+    /// Trusted Rust adapter seam only. Retain the original native validation as
+    /// owner; do not wrap JSON, a boolean, inventory metadata or grant expiry as
+    /// live authority. Also retain ANY stricter original producer validation
+    /// cutoff (for example native's current 250 ms query-as-lifetime contract).
+    /// Caller retains its issuance/lifecycle owner separately.
+    pub fn new(query:ConnectQuery, addresses:HostIpv4DenySet, grant:ConnectDeadline,
+        inventory:ConnectDeadline, producer_current_until:ConnectDeadline,
+        owner:Arc<dyn ConnectValidationGuard>) -> Result<Self> {
+        let last = Mutex::new(query.started);
+        let value = Self { query, grant, inventory, producer_current_until, addresses, owner, last, denied:AtomicBool::new(false) };
+        value.check_adoption()?;
+        Ok(value)
+    }
+    pub(crate) fn matches(&self, binding: &ConnectBinding, identity: &Arc<()>) -> bool {
+        self.query.binding == *binding && Arc::ptr_eq(&self.query.identity, identity)
+    }
+    fn sample(&self, adoption: bool) -> Result<()> {
+        let result = (|| {
+            if self.denied.load(Ordering::Acquire) { return Err(Error::new(Kind::AuthorityDenied)); }
+            // Only clock syscalls/arithmetic under this mutex; NEVER callbacks.
+            let mut last = self.last.lock().map_err(|_|Error::new(Kind::AuthorityDenied))?;
+            let now = Sample::now()?;
+            if now.wall_ms < last.wall_ms || now.boot_ns < last.boot_ns {
+                return Err(Error::new(Kind::AuthorityDenied));
+            }
+            self.grant.check(now)?; self.inventory.check(now)?;
+            self.producer_current_until.check(now)?; self.query.stale_at.check(now)?;
+            if adoption { self.query.adopt_by.check(now)?; }
+            *last = now;
+            Ok(())
+        })();
+        if result.is_err() { self.denied.store(true, Ordering::Release); }
+        result
+    }
+    /// No arbitrary callback or authority IO: safe for the independent socket
+    /// expiry watchdog even while a validation callback is still blocked.
+    pub(crate) fn check_bounds(&self) -> Result<()> { self.sample(false) }
+    pub(crate) fn check_adoption_bounds(&self) -> Result<()> { self.sample(true) }
+    pub(crate) fn check_adoption(&self) -> Result<&HostIpv4DenySet> {
+        self.checked(true)
+    }
+    pub fn check_current(&self) -> Result<&HostIpv4DenySet> { self.checked(false) }
+    fn checked(&self, adoption: bool) -> Result<&HostIpv4DenySet> {
+        let result = (|| {
+            self.sample(adoption)?;
+            self.owner.check_current()?; // No engine IO/clock mutex is held.
+            self.sample(adoption)?; // Callback delay cannot manufacture time.
+            Ok(&self.addresses)
+        })();
+        if result.is_err() { self.denied.store(true, Ordering::Release); }
+        result
+    }
+}
+
+// Explicit standalone qualifier/test fixture only; not a public/native inventory
+// constructor. Its synthetic finite lifetime starts BEFORE any callback.
+pub(super) fn qualifier_deadline(ms:i64) -> ConnectDeadline {
+    assert!((1..=60_000).contains(&ms), "qualification-only finite lifetime");
+    ConnectDeadline::after(Sample::now().unwrap(), ms).unwrap()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    include!("validity_tests.rs");
+}
diff --git a/engine/src/execution/network/connected/validity_relay_tests.rs b/engine/src/execution/network/connected/validity_relay_tests.rs
new file mode 100644
index 0000000..e1c0f7b
--- /dev/null
+++ b/engine/src/execution/network/connected/validity_relay_tests.rs
@@ -0,0 +1,129 @@
+// Included in relay::tests; all authorities here are synthetic retained test
+// owners, never production inventory/grant constructors.
+struct Release(Option<mpsc::SyncSender<()>>);
+impl Release { fn open(&mut self) { self.0.take().unwrap().send(()).unwrap(); } }
+impl Drop for Release { fn drop(&mut self) { if let Some(send) = self.0.take() { let _ = send.try_send(()); } } }
+
+struct DelayedAuthority {
+    grant:ConnectDeadline, inventory:ConnectDeadline, producer:ConnectDeadline,
+    entered:mpsc::SyncSender<()>, release:Mutex<mpsc::Receiver<()>>,
+}
+impl ConnectValidationGuard for DelayedAuthority {
+    fn check_current(&self) -> Result<()> { Ok(()) }
+}
+impl ConnectAuthority for DelayedAuthority {
+    fn validate(self:Arc<Self>, query:ConnectQuery) -> Result<ConnectValidation> {
+        let host = HostIpv4DenySet::from_trusted_host_inventory([Ipv4Addr::LOCALHOST]).unwrap();
+        let validation = ConnectValidation::new(query, host, self.grant, self.inventory, self.producer, self.clone())?;
+        self.entered.send(()).map_err(|_|Error::authority_denied())?;
+        self.release.lock().unwrap().recv_timeout(Duration::from_secs(2)).map_err(|_|Error::authority_denied())?;
+        Ok(validation) // Was valid before blocking. Runtime must recheck on return.
+    }
+}
+
+#[test]
+fn delayed_callback_cannot_adopt_after_original_query_grant_inventory_or_producer_expiry() {
+    // 0: engine adoption; 1: original grant; 2: inventory; 3: producer query.
+    for expired in 0..4 {
+        let mut fixture = Fixture::new();
+        let (entered, wait) = mpsc::sync_channel(1); let (release, gate) = mpsc::sync_channel(1);
+        let mut release = Release(Some(release));
+        let fixed = qualifier_deadline(60_000); let shorter = qualifier_deadline(100);
+        let authority = Arc::new(DelayedAuthority { grant:if expired == 1 { shorter } else { fixed },
+            inventory:if expired == 2 { shorter } else { fixed }, producer:if expired == 3 { shorter } else { fixed },
+            entered, release:Mutex::new(gate) });
+        Arc::get_mut(&mut fixture.shared).unwrap().authority = authority.clone();
+        let previous = fixture.shared.validation().unwrap();
+        let shared = fixture.shared.clone(); let (returned, result) = mpsc::sync_channel(1);
+        let mut worker = Worker::spawn("connect-delayed-valid-result", move || {
+            let answer = shared.grant().and_then(|validation|shared.adopt_grant(validation));
+            returned.send(answer).unwrap();
+        }).unwrap();
+        wait.recv_timeout(Duration::from_secs(1)).unwrap();
+        assert_eq!(worker.settle(Instant::now() + Duration::from_millis(10)).unwrap_err().kind(), Kind::Unsettled);
+        assert!(worker.join.is_some() && Arc::strong_count(&authority) >= 3);
+        thread::sleep(Duration::from_millis(if expired == 0 { 225 } else { 125 }));
+        release.open();
+        assert_eq!(result.recv_timeout(Duration::from_secs(1)).unwrap().unwrap_err().kind(), Kind::AuthorityDenied);
+        worker.settle(Instant::now() + Duration::from_secs(1)).unwrap();
+        assert!(worker.join.is_none() && fixture.shared.cancelled());
+        assert!(Arc::ptr_eq(&previous, &fixture.shared.validation().unwrap()));
+        assert_eq!(fixture.shared.stats.upstreams.load(Ordering::Acquire), 0);
+    }
+}
+
+#[test]
+fn returning_a_different_original_query_cannot_substitute_matching_metadata() {
+    struct Substitute(Mutex<Option<ConnectQuery>>, ConnectDeadline);
+    impl ConnectValidationGuard for Substitute { fn check_current(&self) -> Result<()> { Ok(()) } }
+    impl ConnectAuthority for Substitute {
+        fn validate(self:Arc<Self>, _actual:ConnectQuery) -> Result<ConnectValidation> {
+            let other = self.0.lock().unwrap().take().unwrap();
+            let host = HostIpv4DenySet::from_trusted_host_inventory([Ipv4Addr::LOCALHOST]).unwrap();
+            ConnectValidation::new(other, host, self.1, self.1, self.1, self)
+        }
+    }
+    let mut fixture = Fixture::new(); let previous = fixture.shared.validation().unwrap();
+    let other = ConnectQuery::begin(&fixture.shared.binding).unwrap();
+    Arc::get_mut(&mut fixture.shared).unwrap().authority = Arc::new(Substitute(Mutex::new(Some(other)), qualifier_deadline(60_000)));
+    assert_eq!(fixture.shared.grant().unwrap_err().kind(), Kind::BindingMismatch);
+    assert!(fixture.shared.cancelled());
+    assert!(Arc::ptr_eq(&previous, &fixture.shared.validation().unwrap()));
+}
+
+struct BlockingGuard {
+    block:AtomicBool, entered:mpsc::SyncSender<()>, release:Mutex<mpsc::Receiver<()>>,
+}
+impl ConnectValidationGuard for BlockingGuard {
+    fn check_current(&self) -> Result<()> {
+        if self.block.swap(false, Ordering::AcqRel) {
+            self.entered.send(()).map_err(|_|Error::authority_denied())?;
+            self.release.lock().unwrap().recv_timeout(Duration::from_secs(2)).map_err(|_|Error::authority_denied())?;
+        }
+        Ok(())
+    }
+}
+
+#[test]
+fn callback_free_watchdog_closes_sockets_while_effect_guard_stalls_and_keeps_actual_worker_owned() {
+    let fixture = Fixture::new();
+    let (entered, wait) = mpsc::sync_channel(1); let (release, gate) = mpsc::sync_channel(1);
+    let mut release = Release(Some(release));
+    let guard = Arc::new(BlockingGuard { block:AtomicBool::new(false), entered, release:Mutex::new(gate) });
+    let query = ConnectQuery::begin(&fixture.shared.binding).unwrap();
+    let host = HostIpv4DenySet::from_trusted_host_inventory([Ipv4Addr::LOCALHOST]).unwrap();
+    let validation = Arc::new(ConnectValidation::new(query, host, qualifier_deadline(60_000), qualifier_deadline(150), qualifier_deadline(60_000), guard.clone()).unwrap());
+    fixture.shared.adopt_grant(validation.clone()).unwrap();
+    let (mut peer, proxy) = pair();
+    fixture.shared.stats.active.store(1, Ordering::Release);
+    let connection = Connection { stream:TrackedStream::new(proxy, &fixture.shared),
+        _permit:ActivePermit(fixture.shared.clone()), accepted:Instant::now() };
+    let shared = fixture.shared.clone();
+    guard.block.store(true, Ordering::Release);
+    let worker = Worker::spawn("connect-blocked-effect-guard", move || {
+        let mut connection = connection;
+        let mut meter = Meter { shared:&shared, used:0 };
+        assert!(meter.read(&mut connection.stream.stream, &mut [0u8;1]).is_err());
+    }).unwrap();
+    let mut owner = OwnedConnectProxy { shared:fixture.shared.clone(), workers:vec![worker], ready:None, settled:false };
+    wait.recv_timeout(Duration::from_secs(1)).unwrap();
+    // These actual IO ownership locks must remain free during the arbitrary
+    // callback, independently of its worker's continued custody/charge.
+    assert!(fixture.shared.validation.try_lock().is_ok());
+    assert!(fixture.shared.sockets.try_lock().is_ok());
+    let end = Instant::now() + Duration::from_secs(1);
+    while validation.check_bounds().is_ok() {
+        assert!(Instant::now() < end); thread::sleep(Duration::from_millis(1));
+    }
+    assert!(!fixture.shared.keep_admitted());
+    assert_eq!(peer.read(&mut [0u8;1]).unwrap(), 0); // Independent real socket shutdown.
+    assert!(matches!(owner.close_and_settle(Duration::from_millis(10)), Err(error) if error.kind() == Kind::Unsettled));
+    assert_eq!(fixture.shared.stats.active.load(Ordering::Acquire), 1);
+    assert!(fixture.shared.witnesses.lock().unwrap().is_some());
+    assert!(owner.workers[0].join.is_some());
+    release.open();
+    let settled = owner.close_and_settle(Duration::from_secs(1)).unwrap();
+    assert_eq!(settled.snapshot().active_connections, 0);
+    assert!(fixture.shared.sockets.lock().unwrap().is_empty());
+    assert!(fixture.shared.witnesses.lock().unwrap().is_none());
+}
diff --git a/engine/src/execution/network/connected/validity_tests.rs b/engine/src/execution/network/connected/validity_tests.rs
new file mode 100644
index 0000000..55a4e18
--- /dev/null
+++ b/engine/src/execution/network/connected/validity_tests.rs
@@ -0,0 +1,82 @@
+struct HeldGuard(AtomicBool);
+impl ConnectValidationGuard for HeldGuard {
+    fn check_current(&self) -> Result<()> {
+        if self.0.load(Ordering::Acquire) { Ok(()) }
+        else { Err(Error::authority_denied()) }
+    }
+}
+fn binding() -> ConnectBinding {
+    ConnectBinding::for_profile(&super::super::qualification::test_profile()).unwrap()
+}
+fn host() -> HostIpv4DenySet {
+    HostIpv4DenySet::from_trusted_host_inventory([std::net::Ipv4Addr::LOCALHOST]).unwrap()
+}
+fn validation() -> ConnectValidation {
+    let query = ConnectQuery::begin(&binding()).unwrap(); let fixed = qualifier_deadline(60_000);
+    ConnectValidation::new(query, host(), fixed, fixed, fixed, Arc::new(HeldGuard(AtomicBool::new(true)))).unwrap()
+}
+fn until(mut ready: impl FnMut() -> bool) {
+    let end = std::time::Instant::now() + std::time::Duration::from_secs(2);
+    while !ready() {
+        assert!(std::time::Instant::now() < end, "original bound did not expire");
+        std::thread::sleep(std::time::Duration::from_millis(1));
+    }
+}
+
+#[test]
+fn exact_original_query_identity_cannot_be_replaced_by_matching_binding_data() {
+    let binding = binding(); let query = ConnectQuery::begin(&binding).unwrap(); let key = query.identity();
+    let other = ConnectQuery::begin(&binding).unwrap(); let fixed = qualifier_deadline(60_000);
+    let value = ConnectValidation::new(query, host(), fixed, fixed, fixed, Arc::new(HeldGuard(AtomicBool::new(true)))).unwrap();
+    assert!(value.matches(&binding, &key)); assert!(!value.matches(&binding, &other.identity()));
+    let mut wrong = binding; wrong.network.owner = "different-owner".into();
+    assert!(!value.matches(&wrong, &key));
+}
+
+#[test]
+fn adoption_cutoff_is_distinct_from_the_original_continuing_window() {
+    let value = validation();
+    let original = value.query.stale_at;
+    until(|| value.query.adopt_by.check(Sample::now().unwrap()).is_err());
+    value.check_current().unwrap(); // An already-adopted fast query can continue.
+    assert_eq!(value.query.stale_at.wall_ms, original.wall_ms);
+    assert_eq!(value.query.stale_at.boot_ns, original.boot_ns);
+    assert!(value.check_adoption().is_err()); // Same late value cannot be adopted now.
+    assert!(value.check_current().is_err()); // Refusal is absorbing, never renewed.
+}
+
+#[test]
+fn original_grant_inventory_and_producer_each_refuse_either_expired_clock_at_creation() {
+    for expired_component in 0..3 {
+        for wall_expired in [false, true] {
+            let query = ConnectQuery::begin(&binding()).unwrap(); let now = Sample::now().unwrap();
+            let live = qualifier_deadline(60_000);
+            let expired = ConnectDeadline::from_original(
+                if wall_expired { now.wall_ms - 1 } else { live.wall_ms },
+                if wall_expired { live.boot_ns } else { now.boot_ns - 1 }).unwrap();
+            let grant = if expired_component == 0 { expired } else { live };
+            let inventory = if expired_component == 1 { expired } else { live };
+            let producer = if expired_component == 2 { expired } else { live };
+            assert!(ConnectValidation::new(query, host(), grant, inventory, producer,
+                Arc::new(HeldGuard(AtomicBool::new(true)))).is_err());
+        }
+    }
+}
+
+#[test]
+fn clock_regression_and_live_guard_denial_cannot_be_repaired_on_the_same_result() {
+    for wall in [false, true] {
+        let value = validation(); let actual = Sample::now().unwrap();
+        { let mut last = value.last.lock().unwrap();
+            if wall { last.wall_ms = actual.wall_ms + 60_000; }
+            else { last.boot_ns = actual.boot_ns + 60_000 * NS_PER_MS; } }
+        assert!(value.check_bounds().is_err());
+        *value.last.lock().unwrap() = actual;
+        assert!(value.check_current().is_err());
+    }
+    let query = ConnectQuery::begin(&binding()).unwrap(); let fixed = qualifier_deadline(60_000);
+    let owner = Arc::new(HeldGuard(AtomicBool::new(true)));
+    let value = ConnectValidation::new(query, host(), fixed, fixed, fixed, owner.clone()).unwrap();
+    owner.0.store(false, Ordering::Release); assert!(value.check_current().is_err());
+    owner.0.store(true, Ordering::Release); assert!(value.check_current().is_err());
+}
