+    let (job, probe) = case.tls_job(&key); case.submit(job);
+    wait_until(|| case.supervisor.status()[key.slot].busy);
+    assert!(case.supervisor.try_take_joined().is_none());
+    assert!(!probe.ended.load(Ordering::Acquire));
