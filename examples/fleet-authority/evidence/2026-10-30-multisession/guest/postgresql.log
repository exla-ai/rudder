	  IF p.owner_engine_instance<>engine THEN RETURN '{"status":"conflict","reason":"engine_instance"}'; END IF;
	  SELECT * INTO changed FROM q_documented_integration(p.authority_id,p.account_id,p.project_id,
	    expected_epoch,engine,p.lease_id,0,'base','candidate-' || candidate,'source-' || candidate,
	    'environment',q_id(project_label || ':verification:' || verification_candidate));
	  IF NOT FOUND THEN RETURN '{"status":"conflict","reason":"cas_precondition"}'; END IF;
