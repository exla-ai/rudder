	    owner_epoch,previous_head,new_head,source_root,environment_root,verification_id,project_seq)
	    VALUES(p.authority_id,p.account_id,p.project_id,operation,changed.integration_version,0,
	      expected_epoch,'base','candidate-' || candidate,'source-' || candidate,'environment',
	      q_id(project_label || ':verification:' || verification_candidate),changed.event_seq);
