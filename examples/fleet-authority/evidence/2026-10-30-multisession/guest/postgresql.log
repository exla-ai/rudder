	BEGIN
	  INSERT INTO events(authority_id,account_id,project_id,project_seq,event_id,kind,principal_id,payload)
	    VALUES(q_id('authority'),'fixture',project,seq,operation,operation_kind,'qualifier-user',receipt);
	  INSERT INTO idempotency(authority_id,account_id,project_id,principal_id,idempotency_key,
	      operation_id,operation_kind,request_sha256,request_canonical,accepted_seq,accepted_receipt)
	    VALUES(q_id('authority'),'fixture',project,'qualifier-user',operation_key,operation,
	      operation_kind,encode(pg_catalog.sha256(canonical),'hex'),canonical,seq,receipt);
	  INSERT INTO outbox(authority_id,account_id,project_id,outbox_id,event_seq,kind,destination,payload,status)
	    VALUES(q_id('authority'),'fixture',project,q_id(operation::text || ':outbox'),seq,
	      operation_kind,'synthetic-sink',receipt,'pending');
	END $$;
2026-10-30 20:24:54.347 UTC [690] install LOG:  statement: CREATE FUNCTION q_claim(project_label text, engine_label text, boot text,
	                        expected_epoch bigint, operation_key text, lease_ms integer DEFAULT 15000)
	RETURNS jsonb LANGUAGE plpgsql AS $$
	DECLARE p projects%ROWTYPE; at_time timestamptz; canonical bytea; prior jsonb; receipt jsonb;
	        operation uuid; engine uuid := q_id('engine:' || engine_label);
	BEGIN
	  p:=q_lock(project_label);
	  IF NOT q_engine_ok(engine,boot) THEN RETURN '{"status":"conflict","reason":"engine_boot"}'; END IF;
	  canonical:=convert_to(jsonb_build_array('claim-v1',engine,boot,expected_epoch,lease_ms)::text,'UTF8');
	  prior:=q_prior(p.project_id,operation_key,'claim',canonical);
	  IF prior IS NOT NULL THEN RETURN prior; END IF;
	  at_time:=clock_timestamp();
	  IF p.mode<>'ready' OR p.owner_epoch<>expected_epoch THEN
	    RETURN '{"status":"conflict","reason":"stale_epoch"}'; END IF;
	  IF p.owner_engine_instance IS NOT NULL AND p.lease_until>at_time THEN
	    RETURN '{"status":"conflict","reason":"owner_live"}'; END IF;
	  IF lease_ms<1 OR lease_ms>15000 THEN RAISE EXCEPTION 'fixture lease limit'; END IF;
	  operation:=q_id(p.project_id::text || ':' || operation_key);
	  UPDATE projects SET owner_epoch=owner_epoch+1,owner_engine_instance=engine,
	    lease_id=q_id(operation::text || ':lease'),lease_until=at_time+lease_ms*interval '1 millisecond',
	    renew_serial=0,event_seq=event_seq+1
	    WHERE authority_id=p.authority_id AND account_id=p.account_id AND project_id=p.project_id
	    RETURNING * INTO p;
	  INSERT INTO ownership_receipts(authority_id,account_id,project_id,owner_epoch,
	    owner_engine_instance,operation_id,cause,receipt_canonical)
	    VALUES(p.authority_id,p.account_id,p.project_id,p.owner_epoch,engine,operation,'claimed',canonical);
	  receipt:=jsonb_build_object('status','accepted','operation_id',operation,'owner_epoch',p.owner_epoch,
	    'lease_id',p.lease_id,'lease_until',p.lease_until,'project_seq',p.event_seq,'engine',engine);
	  PERFORM q_record(p.project_id,operation_key,'claim',canonical,receipt);
	  RETURN receipt;
	END $$;
2026-10-30 20:24:54.348 UTC [690] install LOG:  statement: CREATE FUNCTION q_renew(project_label text, engine_label text, boot text, expected_epoch bigint,
	                        expected_serial bigint, request_label text) RETURNS jsonb LANGUAGE plpgsql AS $$
	DECLARE p projects%ROWTYPE; grant_row record; at_time timestamptz; canonical bytea;
	        existing lease_renewals%ROWTYPE; engine uuid:=q_id('engine:' || engine_label);
	        request uuid:=q_id('renewal:' || project_label || ':' || request_label);
	BEGIN
	  p:=q_lock(project_label);
	  IF NOT q_engine_ok(engine,boot) THEN RETURN '{"status":"conflict","reason":"engine_boot"}'; END IF;
	  canonical:=convert_to(jsonb_build_array('renew-v1',engine,boot,expected_epoch,p.lease_id,expected_serial)::text,'UTF8');
	  SELECT * INTO existing FROM lease_renewals WHERE authority_id=p.authority_id
	    AND account_id=p.account_id AND project_id=p.project_id AND request_id=request;
	  IF FOUND THEN
	    IF existing.request_canonical<>canonical THEN RETURN '{"status":"conflict","reason":"idempotency_conflict"}'; END IF;
	    RETURN jsonb_build_object('status','renewed','renew_serial',existing.renew_serial,
	      'lease_until',existing.lease_until,'issued_at',existing.issued_at,'lease_id',existing.lease_id);
	  END IF;
	  at_time:=clock_timestamp(); -- deliberately sampled AFTER the potentially waiting project lock
	  IF p.owner_epoch<>expected_epoch THEN RETURN '{"status":"conflict","reason":"stale_epoch"}'; END IF;
	  IF p.owner_engine_instance<>engine THEN RETURN '{"status":"conflict","reason":"engine_instance"}'; END IF;
	  SELECT * INTO grant_row FROM q_documented_renew(p.authority_id,p.account_id,p.project_id,
	    expected_epoch,engine,p.lease_id,expected_serial,at_time);
	  IF NOT FOUND THEN
	    RETURN jsonb_build_object('status','conflict','reason','expired_or_serial','checked_at',at_time,
	      'transaction_started_at',transaction_timestamp(),'lease_until',p.lease_until,
	      'transaction_clock_would_allow',p.lease_until>transaction_timestamp());
	  END IF;
	  INSERT INTO lease_renewals(authority_id,account_id,project_id,request_id,grant_kind,owner_epoch,
	    lease_id,renew_serial,engine_instance_id,request_canonical,issued_at,lease_until)
	    VALUES(p.authority_id,p.account_id,p.project_id,request,'owner',expected_epoch,
	      grant_row.lease_id,grant_row.renew_serial,engine,canonical,at_time,grant_row.lease_until);
	  RETURN jsonb_build_object('status','renewed','renew_serial',grant_row.renew_serial,
	    'lease_until',grant_row.lease_until,'issued_at',at_time,'lease_id',grant_row.lease_id);
	END $$;
2026-10-30 20:24:54.348 UTC [690] install LOG:  statement: CREATE FUNCTION q_topic(project_label text, operation_key text, expected_version bigint)
	RETURNS jsonb LANGUAGE plpgsql AS $$
	DECLARE p projects%ROWTYPE; canonical bytea; prior jsonb; receipt jsonb; version bigint;
	        previous uuid; operation uuid;
	BEGIN
	  p:=q_lock(project_label);
	  canonical:=convert_to(jsonb_build_array('topic-v1','policy/verification',expected_version)::text,'UTF8');
	  prior:=q_prior(p.project_id,operation_key,'decision',canonical);
	  IF prior IS NOT NULL THEN RETURN prior; END IF;
	  SELECT t.version,t.decision_id INTO version,previous FROM topics t WHERE t.authority_id=p.authority_id
	    AND t.account_id=p.account_id AND t.project_id=p.project_id AND t.topic='policy/verification';
	  IF COALESCE(version,0)<>expected_version THEN RETURN '{"status":"conflict","reason":"topic_version"}'; END IF;
	  operation:=q_id(p.project_id::text || ':' || operation_key);
	  UPDATE projects SET event_seq=event_seq+1 WHERE authority_id=p.authority_id
	    AND account_id=p.account_id AND project_id=p.project_id RETURNING * INTO p;
	  receipt:=jsonb_build_object('status','accepted','operation_id',operation,
	    'topic_version',expected_version+1,'project_seq',p.event_seq);
	  PERFORM q_record(p.project_id,operation_key,'decision',canonical,receipt);
	  INSERT INTO decisions(authority_id,account_id,project_id,decision_id,topic,version,
	    principal_id,scope,statement,previous_id,project_seq)
	    VALUES(p.authority_id,p.account_id,p.project_id,operation,'policy/verification',expected_version+1,
	      'qualifier-user','project','{"synthetic":true}',previous,p.event_seq);
	  INSERT INTO topics(authority_id,account_id,project_id,topic,version,decision_id)
	    VALUES(p.authority_id,p.account_id,p.project_id,'policy/verification',expected_version+1,operation)
	    ON CONFLICT(authority_id,account_id,project_id,topic)
	    DO UPDATE SET version=EXCLUDED.version,decision_id=EXCLUDED.decision_id;
	  RETURN receipt;
	END $$;
2026-10-30 20:24:54.349 UTC [690] install LOG:  statement: CREATE FUNCTION q_verifications(project_label text) RETURNS void LANGUAGE plpgsql AS $$
