	        p.owner_epoch,p.integration_version,p.head_vcs_commit,'candidate-' || candidate,
	        'source-' || candidate,'environment','evidence','build-contract');
	    INSERT INTO verification_topics(authority_id,account_id,project_id,verification_id,topic,expected_version)
	      VALUES(p.authority_id,p.account_id,p.project_id,q_id(project_label || ':verification:' || candidate),
	        'policy/verification',COALESCE(current_policy,0));
	  END LOOP;
