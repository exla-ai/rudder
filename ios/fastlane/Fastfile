# fastlane Fastfile: Rudder iOS, for installing straight onto a phone from a
# Mac (ios/scripts/install-device.sh). Auth is the App Store Connect API key
# from fastlane/.asc.env (gitignored), which must be a key of the team in
# ios/project.yml (Exla Corp.), and the Mac needs that team's Apple
# Development certificate. App Store builds do not use fastlane:
# ios/scripts/appstore.sh signs them with the team's cloud-managed certificate.
require "yaml"

default_platform(:ios)

# The bundle id from ios/project.yml, the one place it is set.
APP_ID = YAML.load_file(File.expand_path("../project.yml", __dir__)).dig("targets", "Rudder", "settings", "base", "PRODUCT_BUNDLE_IDENTIFIER")

def asc_api_key
  return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false,
  )
end

platform :ios do
  desc "Register an iPhone (UDID env DEVICE_UDID) and make a development profile for direct installs."
  lane :dev_signing do
    key = asc_api_key
    UI.user_error!("ASC API key not configured") unless key
    if ENV["DEVICE_UDID"]
      register_devices(api_key: key, devices: { (ENV["DEVICE_NAME"] || "iPhone") => ENV["DEVICE_UDID"] }, platform: "ios")
    end
    sigh(api_key: key, app_identifier: APP_ID, platform: "ios", development: true, force: true, output_path: "build/profiles")
  end
end
