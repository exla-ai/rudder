# fastlane Fastfile: Rudder iOS. Auth is the App Store Connect API key from
# fastlane/.asc.env (gitignored). The .ipa itself is built by the
# ios-testflight skill's build-ipa.sh (no xcodebuild build service).
default_platform(:ios)

APP_ID = ENV["APP_IDENTIFIER"] || "dev.viraat.rudder"

def asc_api_key
  return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false,
  )
end

platform :ios do
  desc "Distribution certificate + App Store provisioning profile."
  lane :prep_signing do
    key = asc_api_key
    UI.user_error!("ASC API key not configured") unless key
    cert(api_key: key, generate_apple_certs: true, output_path: "build/certs")
    sigh(api_key: key, app_identifier: APP_ID, platform: "ios", force: true, output_path: "build/profiles")
  end
end
