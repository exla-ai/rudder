{
  "format_version": 4,
  "sandbox_profile": "uid1500-user-mount-net-pid-procless-seccomp-sdk-v3",
  "source_root": "/workspace/src",
  "output_root": "/workspace/out",
  "umask": 18,
  "environment": {
    "LANG": "C",
    "LC_ALL": "C",
    "TZ": "UTC",
    "HOME": "/tmp",
    "TMPDIR": "/tmp",
    "PATH": "/tools/rust/bin:/tools"
  },
  "python_executable": "/tools/python/bin/python3",
  "python_flags": [
    "-s",
    "-P"
  ],
  "python_home": "/tools/python",
  "rust_output": "library.rlib",
  "rust_argv": [
    "/tools/rust/bin/rustc",
    "--sysroot",
    "/tools/rust",
    "--crate-type=rlib",
    "--edition=2021",
    "--remap-path-prefix=/workspace/src=.",
    "-C",
    "target-cpu=generic",
    "{entrypoint}",
    "-o",
    "{output}"
  ],
  "typescript_argv": [
    "/tools/node",
    "/tools/typescript/lib/tsc.js",
    "--pretty",
    "false",
    "--strict",
    "--target",
    "ES2020",
    "--outDir",
    "{output}",
    "{entrypoint}"
  ],
  "compiler_input_policy": {
    "format_version": 2,
    "kind": "a2-procless-seccomp-read-v2",
    "semantics_version": 2,
    "compiler_proc": "empty-readonly",
    "observer_proc": "original-postfork-held-fd-only",
    "workspace_parent": "readonly",
    "source_read_tree": "/workspace/src",
    "read_file": "/workspace/rules.json",
    "sdk_read_execute_file": "/workspace/buck2",
    "private_read_write_trees": [
      "/workspace/out",
      "/tmp"
    ],
    "absent_payload_paths": [
      "/proc/sys/kernel/random/uuid",
      "/workspace/job.json"
    ],
    "compiler_stdin": "empty-pipe",
    "compiler_descriptors": "stdio-only-at-exec",
    "observer_proc_fd": "close-before-compiler-exec",
    "namespace_clone_mask": 2114060416,
    "deny_errno": 1,
    "clone3_errno": 38,
    "architectures": {
      "x86_64": {
        "audit_arch": 3221225534,
        "clone": 56,
        "clone3": 435,
        "close_range": 436,
        "denied_syscalls": {
          "mount": 165,
          "umount2": 166,
          "pivot_root": 155,
          "chroot": 161,
          "unshare": 272,
          "setns": 308,
          "ptrace": 101,
          "process_vm_readv": 310,
          "process_vm_writev": 311,
          "name_to_handle_at": 303,
          "open_by_handle_at": 304,
          "open_tree": 428,
          "move_mount": 429,
          "fsopen": 430,
          "fsconfig": 431,
          "fsmount": 432,
          "fspick": 433,
          "pidfd_getfd": 438,
          "mount_setattr": 442
        }
      },
      "aarch64": {
        "audit_arch": 3221225655,
        "clone": 220,
        "clone3": 435,
        "close_range": 436,
        "denied_syscalls": {
          "mount": 40,
          "umount2": 39,
          "pivot_root": 41,
          "chroot": 51,
          "unshare": 97,
          "setns": 268,
          "ptrace": 117,
          "process_vm_readv": 270,
          "process_vm_writev": 271,
          "name_to_handle_at": 264,
          "open_by_handle_at": 265,
          "open_tree": 428,
          "move_mount": 429,
          "fsopen": 430,
          "fsconfig": 431,
          "fsmount": 432,
          "fspick": 433,
          "pidfd_getfd": 438,
          "mount_setattr": 442
        }
      }
    },
    "unavailable": "refuse",
    "deterministic_execution": false,
    "cache_reuse": false,
    "sdk_root_mount": "ro-nosuid-nodev",
    "workspace_mount": "ro-nosuid-nodev-noexec-recursive-children",
    "source_mount": "ro-nosuid-nodev-noexec",
    "private_mounts": "rw-nosuid-nodev-noexec",
    "foreign_audit_arch": "kill-process",
    "x32_syscall_bit": 1073741824,
    "x32_action": "kill-process"
  }
}
